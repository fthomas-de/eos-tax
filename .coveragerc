[run]
branch = True
# the package this repo ships; the example plugin's placeholder stood here
# before, and coverage measured nothing at all
source = eos_tax
omit =
    eos_tax/migrations/*
    eos_tax/tests/*

[report]
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
