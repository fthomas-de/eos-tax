msgid "database"
msgstr "Datenbank"

#: templates/eos_tax/bots.html:61
msgid "aggregation"
msgstr "Auswertung"

#: templates/eos_tax/bots.html:62
msgid "total"
msgstr "gesamt"

#: templates/eos_tax/help.html:5
msgid "How to pay taxes?"
msgstr "Wie zahle ich Steuern?"

#: templates/eos_tax/help.html:7
#, python-format
msgid "1. Search for: <u>%(tax_corp)s</u>"
msgstr "1. Suche nach: <u>%(tax_corp)s</u>"

#: templates/eos_tax/help.html:9
msgid "2. Right click and select <u>\"Give Money\"</u>"
msgstr "2. Rechtsklick und <u>\"Give Money\"</u> wählen"

#: templates/eos_tax/help.html:10
msgid ""
"3. Copy the \"Amount to pay in Isk\" for the current month and paste it into "
"amount"
msgstr "3. Den Wert aus \"Amount to pay in Isk\" für den laufenden Monat kopieren und als Betrag einfügen"

#: templates/eos_tax/help.html:11
msgid "4. Copy the \"Reason\" into the corresponding field"
msgstr "4. Den \"Reason\" in das entsprechende Feld kopieren"

#: templates/eos_tax/help.html:12
msgid ""
"4a. A reason is only shown for the last month, starting on the 2nd of the "
"current month, to avoid outdated payments."
msgstr "4a. Ein Reason wird nur für den Vormonat angezeigt, ab dem 2. des laufenden Monats, um veraltete Zahlungen zu vermeiden."

