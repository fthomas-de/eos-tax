#: auth_hooks.py:16 templates/eos_tax/base.html:4
#: templates/eos_tax/base.html:29
msgid "Alliance PvE Tax"
msgstr "Alliance PvE Tax"

#: forms.py:74 forms.py:148
msgid "Base tax rate (%)"
msgstr "Basis-Steuersatz (%)"

#: forms.py:112
msgid "Base rate, used for months before the first scheduled change below."
msgstr "Basissatz für Monate vor dem ersten geplanten Wechsel unten."

#: forms.py:129 forms.py:156
msgid "Rate (%)"
msgstr "Satz (%)"

#: models.py:37
msgid "Taxed alliances"
msgstr "Besteuerte Alliances"

#: models.py:38
msgid "Corporations of these alliances are taxed."
msgstr "Corporations dieser Alliances werden besteuert."

#: models.py:46
msgid "Holding corporation"
msgstr "Holding Corporation"

#: models.py:47
msgid "The single corporation that receives the tax payments."
msgstr "Die eine Corporation, die die Steuerzahlungen erhält."

#: models.py:53
msgid "Excluded corporations"
msgstr "Ausgenommene Corporations"

#: models.py:54
msgid "Never taxed and never listed, even inside a taxed alliance."
msgstr "Wird nie besteuert und nie angezeigt, auch innerhalb einer besteuerten Alliance."

#: models.py:57 models.py:147
msgid "Alliance tax rate"
msgstr "Alliance-Steuersatz"

#: models.py:62
msgid "Share of the gross PvE income a corporation owes. 0.1 means 10 percent."
msgstr "Anteil am PvE-Bruttoertrag, den eine Corporation schuldet. 0,1 bedeutet 10 Prozent."

#: models.py:65
msgid "Taxed journal types"
msgstr "Besteuerte Journal-Typen"

#: models.py:68
msgid ""
"Wallet journal ref_types counted as PvE income, for example bounty_prizes."
msgstr "Wallet-Journal-ref_types, die als PvE-Ertrag zählen, zum Beispiel bounty_prizes."

#: models.py:72
msgid "Include the previous month in calculations and on the overview."
msgstr "Vormonat in Berechnung und Übersicht einbeziehen."

#: models.py:76
msgid "Include the running month in calculations and on the overview."
msgstr "Laufenden Monat in Berechnung und Übersicht einbeziehen."

#: models.py:80
msgid "Match payments by their reason code instead of by amount alone."
msgstr "Zahlungen über den Reason-Code zuordnen statt nur über den Betrag."

#: models.py:83
msgid "Bot detection: hours per day"
msgstr "Bot-Erkennung: Stunden pro Tag"

#: models.py:87
msgid ""
"A day counts as suspicious when a character earned taxed income in more than "
"this many different hours of that day."
msgstr "Ein Tag gilt als auffällig, wenn ein Character in mehr als so vielen verschiedenen Stunden dieses Tages besteuerten Ertrag erzielt hat."

#: models.py:92
msgid "Bot detection: days per month"
msgstr "Bot-Erkennung: Tage pro Monat"

#: models.py:96
msgid ""
"A character is listed once it exceeds this many suspicious days within the "
"selected month."
msgstr "Ein Character wird gelistet, sobald er im gewählten Monat mehr als so viele auffällige Tage hat."

#: models.py:102
msgid "Tax configuration"
msgstr "Steuer-Konfiguration"

#: models.py:142 templates/eos_tax/settings.html:44
msgid "Valid from"
msgstr "Gültig ab"

#: models.py:144
msgid "First month this rate applies to. Stored as the first of that month."
msgstr "Erster Monat, für den dieser Satz gilt. Gespeichert als Monatserster."

#: models.py:151
msgid "Share of the gross PvE income. 0.1 means 10 percent."
msgstr "Anteil am PvE-Bruttoertrag. 0,1 bedeutet 10 Prozent."

#: models.py:156
msgid "Tax rate"
msgstr "Steuersatz"

#: models.py:157 templates/eos_tax/settings.html:29
msgid "Tax rate schedule"
msgstr "Steuersatz-Zeitplan"

#: models.py:170
msgid "Corporation ID"
msgstr "Corporation-ID"

#: models.py:171
msgid "Taxed month"
msgstr "Besteuerter Monat"

#: models.py:172
msgid "Taxed year"
msgstr "Besteuertes Jahr"

#: models.py:173
msgid "Corporation name"
msgstr "Corporation-Name"

#: models.py:174
msgid "Tax value"
msgstr "Steuerbetrag"

#: models.py:175
msgid "Tax percentage"
msgstr "Ingame Corp Tax"

#: models.py:176 templates/eos_tax/index.html:24
#: templates/eos_tax/index.html:51
msgid "Payed"
msgstr "Bezahlt"

#: models.py:193
msgid "Applied alliance tax rate"
msgstr "Angewandter Alliance-Steuersatz"

#: models.py:196
msgid ""
"Alliance rate in effect when this row was calculated. Stored per row so "
"changing the rate does not rewrite what past months were owed."
msgstr "Alliance-Satz, der bei der Berechnung dieser Zeile galt. Je Zeile gespeichert, damit eine Satzänderung vergangene Monate nicht rückwirkend verändert."

