#: templates/eos_tax/bots.html:16
#, python-format
msgid ""
"Characters that earned taxed income in more than %(min_hours)s different\n"
"                hours of a day, on more than %(min_days)s days of the "
"selected month. Both thresholds\n"
"                live on the settings page."
msgstr "Characters, die an mehr als %(min_days)s Tagen des gewählten Monats in jeweils mehr als %(min_hours)s verschiedenen Stunden besteuerten Ertrag erzielt haben. Beide Schwellen stehen auf der Einstellungsseite."

#: templates/eos_tax/bots.html:23 templates/eos_tax/index.html:22
#: templates/eos_tax/statistics.html:53
msgid "Month"
msgstr "Monat"

#: templates/eos_tax/bots.html:29
msgid "Show"
msgstr "Anzeigen"

#: templates/eos_tax/bots.html:37
msgid ""
"No character crossed both thresholds. The ten longest days of the month are "
"shown instead, so the thresholds can be judged against real numbers."
msgstr "Kein Character hat beide Schwellen überschritten. Stattdessen werden die zehn längsten Tage des Monats gezeigt, damit sich die Schwellen an echten Zahlen beurteilen lassen."

#: templates/eos_tax/bots.html:43
msgid "No character crossed both thresholds in this month."
msgstr "Kein Character hat in diesem Monat beide Schwellen überschritten."

#: templates/eos_tax/bots.html:55
#, python-format
msgid "%(value)s hour blocks"
msgstr "%(value)s Stundenblöcke"

#: templates/eos_tax/bots.html:56
#, python-format
msgid "%(value)s characters"
msgstr "%(value)s Characters"

#: templates/eos_tax/bots.html:57
#, python-format
