msgstr "Anzeigen"

#: templates/eos_tax/bot-detail.html:160 templates/eos_tax/bots.html:50
#: templates/eos_tax/settings.html:233 views.py:511
msgid "Hours per day"
msgstr "Stunden pro Tag"

#: templates/eos_tax/bot-detail.html:167 templates/eos_tax/bots.html:57
#: templates/eos_tax/settings.html:248 views.py:512
msgid "Unbroken runs"
msgstr "Ununterbrochene Läufe"

#: templates/eos_tax/bot-detail.html:174 templates/eos_tax/bots.html:64
#: templates/eos_tax/settings.html:265 views.py:513
msgid "Against the Corporation"
