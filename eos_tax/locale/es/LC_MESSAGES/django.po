#: templates/eos_tax/help.html:5
msgid "How to pay taxes?"
msgstr "¿Cómo pagar los impuestos?"

#: templates/eos_tax/help.html:7
#, python-format
msgid "1. Search for: <u>%(tax_corp)s</u>"
msgstr "1. Busca: <u>%(tax_corp)s</u>"

#: templates/eos_tax/help.html:9
msgid "2. Right click and select <u>\"Give Money\"</u>"
msgstr "2. Haz clic derecho y elige <u>\"Give Money\"</u>"

#: templates/eos_tax/help.html:10
msgid ""
"3. Copy the \"Amount to pay in Isk\" for the current month and paste it into "
"amount"
msgstr "3. Copia el \"Amount to pay in Isk\" del mes en curso y pégalo en el importe"

#: templates/eos_tax/help.html:11
msgid "4. Copy the \"Reason\" into the corresponding field"
msgstr "4. Copia el \"Reason\" en el campo correspondiente"

#: templates/eos_tax/help.html:12
msgid ""
"4a. A reason is only shown for the last month, starting on the 2nd of the "
"current month, to avoid outdated payments."
msgstr "4a. Solo se muestra un Reason para el mes anterior, a partir del día 2 del mes en curso, para evitar pagos desactualizados."

