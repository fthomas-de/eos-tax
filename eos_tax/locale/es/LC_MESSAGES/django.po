#: templates/eos_tax/base.html:29
msgid "Alliance PvE Tax"
msgstr "Alliance PvE Tax"

#: forms.py:74 forms.py:148
msgid "Base tax rate (%)"
msgstr "Tasa base de impuesto (%)"

#: forms.py:112
msgid "Base rate, used for months before the first scheduled change below."
msgstr "Tasa base, usada para los meses anteriores al primer cambio programado de abajo."

#: forms.py:129 forms.py:156
msgid "Rate (%)"
msgstr "Tasa (%)"

#: models.py:37
msgid "Taxed alliances"
msgstr "Alliances gravadas"

#: models.py:38
msgid "Corporations of these alliances are taxed."
msgstr "Las Corporations de estas Alliances están gravadas."

#: models.py:46
msgid "Holding corporation"
msgstr "Holding Corporation"

#: models.py:47
msgid "The single corporation that receives the tax payments."
msgstr "La única Corporation que recibe los pagos de impuestos."

#: models.py:53
msgid "Excluded corporations"
msgstr "Corporations excluidas"

#: models.py:54
msgid "Never taxed and never listed, even inside a taxed alliance."
msgstr "Nunca gravadas ni listadas, incluso dentro de una Alliance gravada."

#: models.py:57 models.py:147
msgid "Alliance tax rate"
msgstr "Tasa de impuesto de la Alliance"

#: models.py:62
msgid "Share of the gross PvE income a corporation owes. 0.1 means 10 percent."
msgstr "Parte del ingreso bruto PvE que debe una Corporation. 0,1 significa 10 por ciento."

#: models.py:65
msgid "Taxed journal types"
msgstr "Tipos de Journal gravados"

#: models.py:68
msgid ""
"Wallet journal ref_types counted as PvE income, for example bounty_prizes."
msgstr "ref_types del Wallet Journal que cuentan como ingreso PvE, por ejemplo bounty_prizes."

#: models.py:72
msgid "Include the previous month in calculations and on the overview."
msgstr "Incluir el mes anterior en los cálculos y en el resumen."

#: models.py:76
msgid "Include the running month in calculations and on the overview."
msgstr "Incluir el mes en curso en los cálculos y en el resumen."

#: models.py:80
msgid "Match payments by their reason code instead of by amount alone."
msgstr "Asignar los pagos por el código Reason en lugar de solo por el importe."

#: models.py:83
msgid "Bot detection: hours per day"
msgstr "Detección de bots: horas por día"

#: models.py:87
msgid ""
"A day counts as suspicious when a character earned taxed income in more than "
"this many different hours of that day."
msgstr "Un día cuenta como sospechoso cuando un Character obtuvo ingresos gravados en más de esta cantidad de horas distintas de ese día."

#: models.py:92
msgid "Bot detection: days per month"
msgstr "Detección de bots: días por mes"

#: models.py:96
msgid ""
"A character is listed once it exceeds this many suspicious days within the "
"selected month."
msgstr "Un Character se lista en cuanto supera esta cantidad de días sospechosos dentro del mes seleccionado."

#: models.py:102
msgid "Tax configuration"
msgstr "Configuración de impuestos"

#: models.py:142 templates/eos_tax/settings.html:44
msgid "Valid from"
msgstr "Válido desde"

#: models.py:144
msgid "First month this rate applies to. Stored as the first of that month."
msgstr "Primer mes al que se aplica esta tasa. Se guarda como el día uno de ese mes."

#: models.py:151
msgid "Share of the gross PvE income. 0.1 means 10 percent."
msgstr "Parte del ingreso bruto PvE. 0,1 significa 10 por ciento."

#: models.py:156
msgid "Tax rate"
msgstr "Tasa de impuesto"

#: models.py:157 templates/eos_tax/settings.html:29
