#: models.py:170
msgid "Corporation ID"
msgstr "ID de Corporation"

#: models.py:171
msgid "Taxed month"
msgstr "Mes gravado"

#: models.py:172
msgid "Taxed year"
msgstr "Año gravado"

#: models.py:173
msgid "Corporation name"
msgstr "Nombre de la Corporation"

#: models.py:174
msgid "Tax value"
msgstr "Importe del impuesto"

#: models.py:175
msgid "Tax percentage"
msgstr "Ingame Corp Tax"

#: models.py:176 templates/eos_tax/index.html:24
#: templates/eos_tax/index.html:51
msgid "Payed"
msgstr "Pagado"

#: models.py:193
msgid "Applied alliance tax rate"
msgstr "Tasa de Alliance aplicada"

#: models.py:196
msgid ""
"Alliance rate in effect when this row was calculated. Stored per row so "
"changing the rate does not rewrite what past months were owed."
msgstr "Tasa de la Alliance vigente cuando se calculó esta fila. Se guarda por fila para que un cambio de tasa no reescriba lo que se debía en meses pasados."

