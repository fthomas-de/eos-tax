msgid "Show"
msgstr "Afficher"

#: templates/eos_tax/bot-detail.html:165
#, python-format
msgid ""
"Active hours per day. An hour counts as active once the same taxed\n"
"                journal type appears in it at least %(min_entries)s times, "
"which is the same rule the\n"
"                list uses. Times are EVE time."
msgstr ""
"Heures actives par jour. Une heure compte comme active dès que le même "
"journal type taxé y apparaît au moins %(min_entries)s fois, la même règle "
"que celle de la liste. Heures en temps EVE."

#: templates/eos_tax/bot-detail.html:174
msgid "Active hours per day, calendar weeks as rows and weekdays as columns"
msgstr ""
"Heures actives par jour, semaines en lignes et jours de la semaine en "
"colonnes"

#: templates/eos_tax/bot-detail.html:179
msgid "Week"
msgstr "Sem."

#: templates/eos_tax/bot-detail.html:203
#, python-format
msgid "Active hours: %(hours)s"
msgstr "Heures actives : %(hours)s"

#: templates/eos_tax/bot-detail.html:224
msgid "quiet"
msgstr "calme"

#: templates/eos_tax/bot-detail.html:229
#, python-format
msgid "%(counter)s hour"
msgid_plural "%(counter)s hours"
msgstr[0] "%(counter)s heure"
msgstr[1] "%(counter)s heures"

#: templates/eos_tax/bot-detail.html:233
#, python-format
