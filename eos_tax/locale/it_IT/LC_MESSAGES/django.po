#: templates/eos_tax/bot-detail.html:86
msgid "Every character of this main"
msgstr "Tutti i characters di questo Main"

#: templates/eos_tax/bot-detail.html:117
msgid "Open one of the bot lists to see how each of them was assessed."
msgstr "Apri una delle liste bot per vedere come è stato valutato ciascuno."

#: templates/eos_tax/bot-detail.html:128
#: templates/eos_tax/tax-change-detail.html:12
msgid "Back to the list"
msgstr "Torna all'elenco"

#: templates/eos_tax/bot-detail.html:136 templates/eos_tax/bots.html:18
#: templates/eos_tax/index.html:54 templates/eos_tax/settings.html:199
#: templates/eos_tax/statistics.html:49
msgid "Month"
msgstr "Mese"

#: templates/eos_tax/bot-detail.html:142 templates/eos_tax/bots.html:31
#: templates/eos_tax/index.html:28 templates/eos_tax/tax-changes.html:35
msgid "Show"
msgstr "Mostra"

#: templates/eos_tax/bot-detail.html:165
#, python-format
msgid ""
"Active hours per day. An hour counts as active once the same taxed\n"
"                journal type appears in it at least %(min_entries)s times, "
"which is the same rule the\n"
"                list uses. Times are EVE time."
msgstr ""
"Ore attive al giorno. Un'ora conta come attiva quando lo stesso journal type "
"tassato vi compare almeno %(min_entries)s volte, la stessa regola usata "
"dall'elenco. Orari in tempo EVE."

#: templates/eos_tax/bot-detail.html:174
msgid "Active hours per day, calendar weeks as rows and weekdays as columns"
msgstr ""
"Ore attive al giorno, settimane come righe e giorni della settimana come "
"colonne"

#: templates/eos_tax/bot-detail.html:179
msgid "Week"
msgstr "Sett."

#: templates/eos_tax/bot-detail.html:203
#, python-format
msgid "Active hours: %(hours)s"
msgstr "Ore attive: %(hours)s"

#: templates/eos_tax/bot-detail.html:224
msgid "quiet"
msgstr "tranquillo"

#: templates/eos_tax/bot-detail.html:229
#, python-format
msgid "%(counter)s hour"
msgid_plural "%(counter)s hours"
msgstr[0] "%(counter)s ora"
msgstr[1] "%(counter)s ore"

