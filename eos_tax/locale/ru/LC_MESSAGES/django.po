#, python-format
msgid ""
"On %(on)s the share moved from %(before)s percent to %(after)s percent, "
"across %(systems)s systems."
msgstr ""
"%(on)s доля изменилась с %(before)s процентов до %(after)s процентов, по "
"%(systems)s системам."

