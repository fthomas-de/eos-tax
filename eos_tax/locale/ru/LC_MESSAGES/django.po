#: templates/eos_tax/bot-detail.html:161 templates/eos_tax/bots.html:57
#: templates/eos_tax/settings.html:234 views.py:496
msgid "Unbroken runs"
msgstr "Непрерывные серии"

#: templates/eos_tax/bot-detail.html:168 templates/eos_tax/bots.html:64
#: templates/eos_tax/settings.html:251 views.py:497
msgid "Against the Corporation"
msgstr "В такт Corporation"

#: templates/eos_tax/bot-detail.html:175 templates/eos_tax/bots.html:71
#: templates/eos_tax/settings.html:269 views.py:498
msgid "Off the Corporation clock"
msgstr "Вне часов Corporation"

#: templates/eos_tax/bot-detail.html:190
#, python-format
msgid ""
"Active hours per day. An hour counts as active once the same taxed\n"
"                journal type appears in it at least %(min_entries)s times, which is the same rule the\n"
"                list uses. Times are EVE time."
msgstr ""
"Активные часы по дням. Час считается активным, если один и тот же облагаемый"
" journal type встречается в нём не менее %(min_entries)s раз — то же "
"правило, что и в списке. Время по EVE."

#: templates/eos_tax/bot-detail.html:199
msgid "Active hours per day, calendar weeks as rows and weekdays as columns"
msgstr "Активные часы по дням, недели по строкам и дни недели по столбцам"

#: templates/eos_tax/bot-detail.html:204
msgid "Week"
msgstr "Нед."

#: templates/eos_tax/bot-detail.html:228
