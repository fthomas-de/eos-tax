msgstr "设置"

#: templates/eos_tax/bot-detail.html:45
msgid "Character Audit"
msgstr "Character 审计"

#: templates/eos_tax/bot-detail.html:70
#, python-format
msgid "%(main)s - %(counter)s more character"
msgid_plural "%(main)s - %(counter)s more characters"
msgstr[0] "%(main)s - 另外 %(counter)s 个 Character"

#: templates/eos_tax/bot-detail.html:87
msgid "Every character of this main"
msgstr "此 Main 的所有 Character"

#: templates/eos_tax/bot-detail.html:118
msgid "Open one of the bot lists to see how each of them was assessed."
msgstr "打开其中一个机器人列表，查看每个 Character 的评估结果。"

#: templates/eos_tax/bot-detail.html:129
#: templates/eos_tax/tax-change-detail.html:12
msgid "Back to the list"
msgstr "返回列表"

